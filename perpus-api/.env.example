APP_NAME="Perpustakaan API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default: SQLite (file database/database.sqlite, tanpa instalasi server DB)
DB_CONNECTION=sqlite
# Untuk MySQL/MariaDB (Laragon/XAMPP/VPS), ganti menjadi:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=perpus_api
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- OpenAPI / Swagger (L5-Swagger) ---
# URL server yang tampil di Swagger UI (samakan dengan APP_URL)
L5_SWAGGER_CONST_HOST=http://localhost:8000
# true = dokumentasi dibuat ulang setiap /api/documentation dibuka (development)
L5_SWAGGER_GENERATE_ALWAYS=true
