# Root .gitignore for Perpus API (Laravel) + Perpus App (Flutter)

# Laravel
perpus-api/vendor/
perpus-api/node_modules/
perpus-api/.env
perpus-api/.env.backup
perpus-api/storage/*.key
perpus-api/storage/logs/
perpus-api/storage/framework/cache/
perpus-api/storage/framework/sessions/
perpus-api/storage/framework/views/
perpus-api/.phpunit.result.cache

# Flutter
perpus_app/.dart_tool/
perpus_app/.flutter-plugins
perpus_app/.flutter-plugins-dependencies
perpus_app/.packages
perpus_app/build/
perpus_app/android/.gradle/
perpus_app/android/local.properties
perpus_app/ios/Pods/
perpus_app/ios/.symlinks/

# OS & Editor
.DS_Store
Thumbs.db
*.log
*.tmp
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.idea/
